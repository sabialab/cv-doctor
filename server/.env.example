# CV-Doctor 后端配置

# DeepSeek API Key（默认快速模型）
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com

# LLM（可选覆盖）
CV_DOCTOR_LLM_PROVIDER=deepseek
CV_DOCTOR_LLM_MODEL=deepseek/deepseek-chat

# 真实流水线（1=启用 LLM pipeline，0=桩数据，CI 默认 0）
USE_REAL_PIPELINE=0

# Kimi API Key（深度分析模型）
KIMI_API_KEY=...

# 数据库
DATABASE_URL=postgresql://user:pass@localhost:5432/cv_doctor

# Redis
REDIS_URL=redis://localhost:6379

# 文件存储
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# 隐私设置
AUTO_DELETE_HOURS=24
# 本地过期清理（须在运行中的 API 进程内执行，勿单独 import 内存库）
ALLOW_ADMIN_PURGE=1
# 本地内存会话过期清理：cd server && uv run python ../scripts/purge-expired-sessions.py

# 限流（本地直连 POST /sessions；经 Worker 时由边缘限流，Container 设 RATE_LIMIT_ENABLED=0）
RATE_LIMIT_ENABLED=1
RATE_LIMIT_SESSIONS_PER_DAY=20

# 调试
DEBUG=false
