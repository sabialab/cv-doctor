# CV-Doctor 后端配置

# DeepSeek API Key（默认快速模型）
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com

# LLM（可选覆盖）
CV_DOCTOR_LLM_PROVIDER=deepseek
CV_DOCTOR_LLM_MODEL=deepseek/deepseek-chat

# 真实流水线（1=启用 LLM pipeline，0=桩数据，CI 默认 0）
USE_REAL_PIPELINE=0

# Kimi API Key（深度分析模型）
KIMI_API_KEY=...

# 数据库
DATABASE_URL=postgresql://user:pass@localhost:5432/cv_doctor

# Redis
REDIS_URL=redis://localhost:6379

# 文件存储
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# 隐私设置
AUTO_DELETE_HOURS=24

# 调试
DEBUG=false
