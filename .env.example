# CV-Doctor 环境变量配置
# 复制此文件为 .env 并填入你的配置

# ==================== LLM 配置 ====================
# LLM 提供商: openai / anthropic / ollama / gemini / ...
CV_DOCTOR_LLM_PROVIDER=openai
CV_DOCTOR_LLM_MODEL=gpt-4o

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=...

# Ollama (本地模型，无需 API Key)
# OLLAMA_BASE_URL=http://localhost:11434

# ==================== 天眼查配置（可选） ====================
# 用于公司画像采集，申请地址: https://open.tianyancha.com/
TIANYANCHA_API_KEY=

# ==================== BOSS直聘配置（可选） ====================
# 用于 JD 自动采集，需要登录 Cookie
# BOSS_COOKIE=

# ==================== 输出配置 ====================
# 输出目录
CV_DOCTOR_OUTPUT_DIR=./output

# 默认输出格式: pdf / docx / markdown
CV_DOCTOR_DEFAULT_FORMAT=pdf

# ==================== 调试 ====================
# 显示 LLM 调用详情
CV_DOCTOR_DEBUG=false
